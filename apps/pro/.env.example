# URL de base de l'API Dorloter (Rust). En dev on passe par le proxy Vite (/api),
# donc laisser vide suffit. En prod, servi en same-origin derriere Caddy.
VITE_API_URL=

# Cible du proxy Vite en dev (defaut : http://localhost:8080)
VITE_API_PROXY=http://localhost:8080

# URL du site public (apps/web). Sert a construire les QR codes des fiches cage,
# qui pointent vers dorloter.fr. En dev : http://localhost:5173 (defaut).
VITE_PUBLIC_WEB_URL=
