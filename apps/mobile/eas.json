{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.dorloter.fr/api/v1",
        "EXPO_PUBLIC_SENTRY_DSN": "$STAGING_SENTRY_DSN"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dorloter.fr/api/v1",
        "EXPO_PUBLIC_SENTRY_DSN": "$PRODUCTION_SENTRY_DSN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
