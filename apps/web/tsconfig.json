{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@infra/*": ["./src/infrastructure/*"],
      "@messaging/*": ["./src/domains/messaging/*"],
      "@moderation/*": ["./src/domains/moderation/*"],
      "@gamification/*": ["./src/domains/gamification/*"],
      "@shelters/*": ["./src/domains/shelters/*"],
      "@lost-found/*": ["./src/domains/lost-found/*"],
      "@adoption/*": ["./src/domains/adoption/*"],
      "@identity/*": ["./src/domains/identity/*"],
      "@notifications/*": ["./src/domains/notifications/*"],
      "@pensions/*": ["./src/domains/pensions/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "tests/e2e", "playwright.config.ts"]
}
