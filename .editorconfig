# EditorConfig · cohérence de style dans le monorepo polyglotte.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# NestJS (apps/api)
[*.{cs,csproj,slnx}]
indent_size = 4

# Markdown : ne pas rogner les espaces de fin (sauts de ligne significatifs)
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab
