{
  "name": "dorloter",
  "version": "0.1.0",
  "private": true,
  "description": "Dorloter · adoption + perdus/trouvés + pensions. Monorepo (apps/api NestJS, apps/web SPA, apps/mobile, packages/api-client).",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@dorloter/web' dev",
    "build": "bun run --filter='*' build",
    "lint": "bun run --filter='*' lint",
    "typecheck": "bun run --filter='*' typecheck",
    "db:init-roles": "docker compose -f docker-compose.yml exec -T postgres psql -U dorloter -d dorloter < scripts/init-db-roles.sql",
    "api:types": "bun scripts/generate-api-types.ts",
    "mobile:assets": "bun scripts/generate-mobile-assets.ts",
    "mobile:build": "./scripts/mobile-build.sh",
    "mobile:dev": "./scripts/mobile-dev.sh",
    "mobile:emu": "./scripts/mobile-emu.sh",
    "prod:build": "COMPOSE_PROJECT_NAME=dorloter-prod docker compose -f docker-compose.prod.yml --env-file .env.production build",
    "prod:up": "COMPOSE_PROJECT_NAME=dorloter-prod docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:down": "COMPOSE_PROJECT_NAME=dorloter-prod docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "COMPOSE_PROJECT_NAME=dorloter-prod docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "prod:init-roles": "./scripts/prod-init-roles.sh",
    "prod:backup": "./scripts/backup.sh"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
