{
  "name": "dorloter",
  "version": "0.1.0",
  "private": true,
  "description": "Dorloter — adoption + perdus/trouvés + pensions. Monorepo (apps/web, apps/mobile, packages/api-client).",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "boundaries": "turbo run boundaries",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "db:push": "bun --cwd apps/web run db:push",
    "db:generate": "bun --cwd apps/web run db:generate",
    "db:migrate": "bun --cwd apps/web run db:migrate",
    "db:studio": "bun --cwd apps/web run db:studio",
    "db:seed": "bun --cwd apps/web run db:seed",
    "db:init-roles": "docker exec -i miaou_postgres_1 psql -U miaou -d miaou < scripts/init-db-roles.sql",
    "api:types": "bun scripts/generate-api-types.ts",
    "prod:build": "COMPOSE_PROJECT_NAME=miaou-prod docker compose -f docker-compose.prod.yml --env-file .env.production build",
    "prod:up": "COMPOSE_PROJECT_NAME=miaou-prod docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:down": "COMPOSE_PROJECT_NAME=miaou-prod docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "COMPOSE_PROJECT_NAME=miaou-prod docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "prod:migrate": "COMPOSE_PROJECT_NAME=miaou-prod docker compose -f docker-compose.prod.yml --env-file .env.production exec app bun x drizzle-kit migrate",
    "prod:init-roles": "./scripts/prod-init-roles.sh",
    "prod:backup": "./scripts/backup.sh"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  }
}
