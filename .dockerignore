# Contexte de build Docker (build context = racine du monorepo, ex. image web).
node_modules
**/node_modules
.git
.github
.vscode
.idea
.claude

# Artefacts de build / cache
**/dist
**/bin
**/obj
**/.turbo
**/.vite
.turbo

# Env & secrets
.env.local
.env.production
.env*.local

# Logs & divers
**/*.log
npm-debug.log*
backups
coverage
*.tsbuildinfo
.DS_Store

# Fichiers infra inutiles dans une image (chemins racine uniquement :
# apps/web/Caddyfile.static est requis par le runtime de l'image web).
**/Dockerfile
.dockerignore
/docker-compose*.yml
/Caddyfile
/Caddyfile.cutover
