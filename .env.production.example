# ─────────────────────────────────────────────────────────────────────────────
# Dorloter · variables d'environnement de production
#
# Copier vers .env.production et remplir. Ne JAMAIS commit ce fichier rempli.
# Utilisé par docker-compose.prod.yml via --env-file ou par défaut
# si docker-compose.prod.yml est invoqué avec `docker compose --env-file .env.production -f ...`.
# ─────────────────────────────────────────────────────────────────────────────

# Domaine principal · utilisé par Caddy pour ACME et pour construire les URLs.
# En local prod-like : utiliser `dorloter.localhost` et ajouter dans /etc/hosts
#   127.0.0.1  dorloter.localhost cdn.dorloter.localhost
DOMAIN=dorloter.fr
ACME_EMAIL=admin@dorloter.fr

# ─── Postgres ────────────────────────────────────────────────────────────────
# Le superuser est utilisé UNIQUEMENT pour les migrations et la création des
# rôles dorloter_app / dorloter_admin. L'app ne s'en sert jamais.
POSTGRES_SUPERUSER=dorloter
POSTGRES_SUPERUSER_PASSWORD=__REPLACE_strong_random_pg_superuser_password__

# Mots de passe pour les 2 rôles applicatifs (créés par scripts/init-db-roles.sql).
# Ces rôles doivent exister en base avant le premier `docker compose up`.
DORLOTER_APP_PASSWORD=__REPLACE_strong_random_app_password__
DORLOTER_ADMIN_PASSWORD=__REPLACE_strong_random_admin_password__

# ─── API · JWT ──────────────────────────────────────────────────────────
# Secret de signature des tokens (>= 32 octets). openssl rand -base64 48
API_JWT_SECRET=__REPLACE_with_32_byte_base64_secret__

# ─── Object storage (MinIO sur ce même VPS) ──────────────────────────────────
S3_ACCESS_KEY=__REPLACE_minio_access_key__
S3_SECRET_KEY=__REPLACE_minio_secret_key__
S3_BUCKET=dorloter-photos

# ─── Cartographie (front SPA · build-time) ───────────────────────────────────
# Style MapLibre. Optionnel : sans valeur, OpenFreeMap est utilisé sans clé.
VITE_MAP_STYLE=

# ─── Email transactionnel (SMTP) ─────────────────────────────────────────────
# Provider-agnostique (SMTP). Recommandé : Brevo (français, offre gratuite
# ~300 mails/jour). Brevo : Host=smtp-relay.brevo.com, Port=587,
# User=<login SMTP Brevo>, Password=<clé SMTP Brevo>.
# Laisser EMAIL_SMTP_HOST vide désactive l'envoi (les emails sont juste loggés).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@dorloter.fr
EMAIL_FROM_NAME=Dorloter

# ─── Services encore à reloger (pas encore portés sur l'API) ────────────
#   - Web Push (VAPID)         · alertes perdus/trouvés
#   - Captcha                  · Cloudflare Turnstile
#   - Modération NSFW photos   · nsfwjs
#   - Gifs                     · Tenor

# ─── Backup S3-compatible (OVH Object Storage par défaut) ────────────────────
# Configuration OVH :
#   1. Console OVH → Public Cloud → Object Storage → créer un bucket
#      (Standard pour accès rapide, Cold Archive pour ~5× moins cher mais
#       restauration en 4h)
#   2. Générer des credentials S3 : Users & Roles → créer un user → S3 credentials
#   3. Renseigner les variables ci-dessous
#
# Endpoints OVH :
#   - Standard : https://s3.gra.io.cloud.ovh.net  (Gravelines, France)
#     autres régions : sbg (Strasbourg), de (Francfort), uk (Londres), …
#   - Cold Archive : https://s3.gra.cloud.ovh.net
#
# Marche aussi avec Scaleway, Backblaze B2, Cloudflare R2 · même variables,
# juste l'endpoint et la région qui changent.
S3_BACKUP_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_BACKUP_REGION=gra
S3_BACKUP_BUCKET=dorloter-backups
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
