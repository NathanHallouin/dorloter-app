# Connexion app publique : rôle à privilèges restreints (voir scripts/init-db-roles.sql)
DATABASE_URL=postgresql://miaou_app:miaou_app@localhost:5438/miaou
# Connexion privilégiée pour les Server Actions platform_admin uniquement.
DATABASE_URL_ADMIN=postgresql://miaou_admin:miaou_admin@localhost:5438/miaou
# Superuser pour les migrations (create/alter table). Non utilisé par l'app.
DATABASE_URL_MIGRATIONS=postgresql://miaou:miaou@localhost:5438/miaou

BETTER_AUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=miaou-photos
S3_PUBLIC_URL=http://localhost:9000/miaou-photos

# Cartographie
NEXT_PUBLIC_MAPTILER_KEY=

# Web Push — générer avec : `node -e "console.log(require('web-push').generateVAPIDKeys())"`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@miaou.fr
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Email transactionnel (Resend) — vide = emails loggés dans la console (dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Miaou <noreply@miaou.fr>"

# Cloudflare Turnstile (captcha sur /register et /login)
# Sans clés, le captcha est désactivé (dev local pratique).
# Pour tester : Cloudflare fournit une clé publique "always passes" :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Modération NSFW des photos à l'upload (nsfwjs local, pas d'API tierce)
# Désactiver en CI ou sur architecture non supportée par TFjs.
# Seuil (0-1) au-delà duquel Porn/Hentai déclenche un refus.
NSFW_CHECK_ENABLED=true
NSFW_BLOCK_THRESHOLD=0.75
