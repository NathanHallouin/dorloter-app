{
  "name": "@dorloter/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client TypeScript typé pour l'API REST Dorloter — généré depuis OpenAPI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
